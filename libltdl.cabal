name:           libltdl
version:        0.2.0
cabal-version:  >= 1.10
license:        BSD3
license-file:   LICENSE
copyright:      (c) 2011 Harvard University
                (c) 2016-2026 Drexel University
author:         Geoffrey Mainland <mainland@drexel.edu>
maintainer:     Geoffrey Mainland <mainland@drexel.edu>
stability:      alpha
homepage:       https://github.com/mainland/libltdl
bug-reports:    https://github.com/mainland/libltdl/issues
category:       Foreign
synopsis:       FFI interface to libltdl
description:    This package provides an interface to GNU libltdl.
tested-with:    GHC==8.0.2,
                GHC==8.2.2,
                GHC==8.4.4,
                GHC==8.6.5,
                GHC==8.8.4,
                GHC==8.10.7,
                GHC==9.0.2,
                GHC==9.2.8,
                GHC==9.4.8,
                GHC==9.6.7,
                GHC==9.8.4,
                GHC==9.10.3,
                GHC==9.12.4,
                GHC==9.14.1

build-type:     Simple

extra-source-files:
  README.md
  CHANGELOG.md

flag examples
  description: Build example programs.
  default:     False

library
  default-language: Haskell2010
  ghc-options: -Wall

  exposed-modules:
    Foreign.LibLTDL
    Foreign.LibLTDL.Internal

  build-depends:
    base >= 4.9 && < 5

  includes:        ltdl.h
  extra-libraries: ltdl

executable sin
  default-language: Haskell2010

  build-depends:
    base >= 4.9 && < 5,
    libltdl

  main-is: Main.hs
  hs-source-dirs: examples/sin

  if flag(examples)
    buildable: True
  else
    buildable: False

test-suite unit
  type: exitcode-stdio-1.0
  hs-source-dirs: tests
  main-is: Main.hs
  default-language: Haskell2010
  ghc-options: -Wall

  build-depends:
    base        >= 4.9  && < 5,
    directory   >= 1.2  && < 1.4,
    libltdl,
    tasty       >= 1.4  && < 1.6,
    tasty-hunit >= 0.10 && < 0.11

  -- Export a zero-address symbol for the missing error message test.
  if os(linux)
    c-sources:  tests/cbits/null-symbol.c
    ld-options: -rdynamic

source-repository head
  type:     git
  location: https://github.com/mainland/libltdl.git
